sub-splinetest-distdir: FORCE
	@test -d splinetest/ || mkdir -p splinetest/
	cd splinetest/ && ( test -e Makefile || $(QMAKE) -o Makefile /usr/local/qwt-6.3.0/tests/splinetest/splinetest.pro ) && $(MAKE) -e -f Makefile distdir DISTDIR=$(DISTDIR)/splinetest

