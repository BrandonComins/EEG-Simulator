####### Compile

obj/Plot.o: Plot.cpp Plot.h \
		../../classincludes/QwtPlot \
		../../src/qwt_plot.h \
		../../src/qwt_global.h \
		../../src/qwt_axis_id.h \
		../../src/qwt_axis.h \
		../../src/qwt_plot_dict.h \
		../../src/qwt_plot_item.h \
		../../classincludes/QwtPlotGraphicItem \
		../../src/qwt_plot_graphicitem.h \
		../../classincludes/QwtPlotLayout \
		../../src/qwt_plot_layout.h \
		../../classincludes/QwtPlotPanner \
		../../src/qwt_plot_panner.h \
		../../src/qwt_panner.h \
		../../classincludes/QwtPlotMagnifier \
		../../src/qwt_plot_magnifier.h \
		../../src/qwt_magnifier.h \
		../../classincludes/QwtGraphic \
		../../src/qwt_graphic.h \
		../../src/qwt_null_paintdevice.h \
		../../classincludes/QwtPlotGrid \
		../../src/qwt_plot_grid.h \
		moc/moc_Plot.cpp
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o obj/Plot.o Plot.cpp

obj/main.o: main.cpp Plot.h \
		../../classincludes/QwtPlot \
		../../src/qwt_plot.h \
		../../src/qwt_global.h \
		../../src/qwt_axis_id.h \
		../../src/qwt_axis.h \
		../../src/qwt_plot_dict.h \
		../../src/qwt_plot_item.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o obj/main.o main.cpp

