check: first

benchmark: first

compiler_rcc_make_all: resources/qrc_svgmap.cpp
compiler_rcc_clean:
	-$(DEL_FILE) resources/qrc_svgmap.cpp
resources/qrc_svgmap.cpp: svgmap.qrc \
		../../../../lib/qt6/libexec/rcc \
		Schlosspark_Nymphenburg.svg
	@echo rcc svgmap.qrc && /usr/lib/qt6/libexec/rcc -name svgmap svgmap.qrc -o resources/qrc_svgmap.cpp

compiler_moc_predefs_make_all: moc/moc_predefs.h
compiler_moc_predefs_clean:
	-$(DEL_FILE) moc/moc_predefs.h
moc/moc_predefs.h: ../../../../lib/x86_64-linux-gnu/qt6/mkspecs/features/data/dummy.cpp
	@echo generating moc/moc_predefs.h
	@g++ -pipe -fno-math-errno -funsafe-math-optimizations -O2 -Wall -Wextra -fPIC -dM -E -o moc/moc_predefs.h ../../../../lib/x86_64-linux-gnu/qt6/mkspecs/features/data/dummy.cpp

compiler_moc_header_make_all: moc/moc_Plot.cpp
